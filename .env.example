[TEMPLATE]
APP_NAME=AI Reliability Platform
ENVIRONMENT=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/reliability
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
# GitHub token with repo scope enables: private-repo auto-sync, file browsing,
# and PR-based change proposals. Without it, public repos of GITHUB_OWNER are used.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Owner for public-repo auto-sync when GITHUB_TOKEN is empty (e.g. Anshul1023).
GITHUB_OWNER=
# AI provider. "demo" works with no key (deterministic answers from live data).
# For real LLM answers, use any OpenAI-compatible endpoint. Free options:
#   Groq free tier:     AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter free:    AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Google Gemini free: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                       AI_MODEL=gemini-2.0-flash
# Get the key from the provider's site (never commit it) and set OPENAI_API_KEY.
AI_PROVIDER=demo
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Required for any public deployment: write endpoints reject requests without this key
# (send it as `Authorization: Bearer <key>` or `X-API-Key: <key>`). Empty = auth disabled.
API_KEY=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=30
